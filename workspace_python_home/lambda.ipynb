   "source": [
    "# lambda 정의 : 익명 함수를 간단하게 정의할 때 사용\n",
    "# lambda 문법 : lambda 매개변수 : 표현식 \n",
    "# lambda 특징 : return 키워드를 적지 않아도 자동으로 반환\n",
    "\n",
    "# 일반 연산\n",
    "add = lambda x, y: x + y\n",
    "print(add(3, 5))\n",
    "\n",
    "# 조건문 활용\n",
    "is_even = lambda x: \"짝수\" if x % 2 == 0 else \"홀수\"\n",
    "print(is_even(2))"
   ]
  }
 ],
